*.avi
*.mov
*.mkv
data/*.mp4
data/*.avi
data/*.mov

# Runtime outputs & databases
data/*.db
data/*.sqlite
outputs/*.csv
outputs/*.mp4
evidence/*.mp4
logs/*.log
scratch_frames/

# Keep directory structures
!outputs/.gitkeep
!evidence/.gitkeep
!logs/.gitkeep
!models/README.md
!data/README.md

