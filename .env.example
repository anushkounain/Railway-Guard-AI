# Model Configuration
# Path to your trained model checkpoint (e.g., best.pt or best new.pt)
MODEL_PATH=C:\Users\91636\Downloads\best new.pt

# Optional secondary model for general intruder detection (pedestrian, vehicles)
SECONDARY_MODEL_PATH=yolov8n.pt

# Detection Mode: "custom" (only best new.pt), "coco" (general intruders), or "hybrid" (both)
DETECTION_MODE=hybrid

# Inference Settings
CONF_THRESHOLD=0.10
IOU_THRESHOLD=0.45
INFERENCE_IMGSZ=640
DEVICE=auto

# Tracker Settings: bytetrack.yaml or botsort.yaml
TRACKER_TYPE=bytetrack.yaml

# Rule Engine Settings
CONSECUTIVE_FRAMES=3
COOLDOWN_SECONDS=10.0
TRACKING_GAP_TOLERANCE=2
BARRIER_STATE_DEFAULT=UNKNOWN

# Evidence Video Generation
EVIDENCE_PRE_SECONDS=2.0
EVIDENCE_POST_SECONDS=3.0

# Server Settings
HOST=127.0.0.1
PORT=8000
